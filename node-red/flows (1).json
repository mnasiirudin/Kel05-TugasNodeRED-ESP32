    {
        "id": "2b0d873406022680",
        "type": "function",
        "z": "06c6eaef09c20749",
        "name": "function 2",
        "func": "var suhu = parseFloat(msg.payload);\nvar parts = msg.topic.split(\"/\");\nvar namaRuang = parts[2]; \n\nif (msg.topic.includes(\"temperature\")) {\n    if (suhu > 32) {\n        // Jika panas, tampilkan peringatan\n        msg.payload = \"⚠️ PERINGATAN! Suhu di \" + namaRuang.toUpperCase() + \" panas: \" + suhu + \" °C\";\n        return msg;\n    } else {\n        // Jika normal (di bawah / sama dengan 32 °C), tampilkan status aman\n        msg.payload = \"✅ Suhu \" + namaRuang.toUpperCase() + \" Normal (\" + suhu + \" °C)\";\n        return msg;\n    }\n}\n\nreturn null;",
